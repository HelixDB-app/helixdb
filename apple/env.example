# Copy to apple/.env and fill in.
# TestFlight: ./apple/build-and-upload-testflight.sh
# Shareable DMG (other Macs): ./apple/build-shareable-dmg.sh
# Get identities: security find-identity -v -p codesigning

# For TestFlight: use exact string from: security find-identity -v -p codesigning
export SIGNING_IDENTITY="Apple Distribution: Your Name (TEAM_ID)"
export INSTALLER_IDENTITY="3rd Party Mac Developer Installer: Your Name (TEAM_ID)"
# Optional: set if Team ID is not parsed from SIGNING_IDENTITY (e.g. APPLE_TEAM_ID=V9G53UFKD3)
export APPLE_TEAM_ID=
# For shareable .dmg (direct share, no TestFlight): Developer ID Application
export DEVELOPER_ID_SIGNING_IDENTITY="Developer ID Application: Your Name (TEAM_ID)"
export APPLE_API_KEY_ID=your_key_id
export APPLE_API_ISSUER=your_issuer_id
export APPLE_API_KEY_PATH=/path/to/AuthKey_XXXXXXXX.p8
# If altool prints ERROR (12) "Cannot determine the Apple ID from Bundle ID … MAC_OS", set the numeric
# App ID from App Store Connect → pgStudio → App Information → Apple ID (not your email).
# export APP_STORE_CONNECT_APP_ID=1234567890
# Multi-team / provider hints (from: xcrun altool --list-providers --api-key … --api-issuer … --p8-file-path …)
# export APPLE_PROVIDER_PUBLIC_ID=
# export APPLE_ASC_PUBLIC_ID=
# export APPLE_ALTTOOL_TEAM_ID=ABCDE12345
