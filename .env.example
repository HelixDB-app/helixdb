# Copy to .env.local (never commit .env.local). See https://nextjs.org/docs/app/building-your-application/configuring/environment-variables

# ── Schema designer cloud sync (long-lived Rust service: schema-sync/) ────────
# Never commit real URLs or passwords. If a database URL was exposed, rotate credentials.
# Run: pnpm exec cargo run --manifest-path schema-sync/Cargo.toml
# NEXT_PUBLIC_* are bundled for the browser — use public HTTPS/WSS endpoints only.
NEXT_PUBLIC_SCHEMA_SYNC_HTTP_URL=
NEXT_PUBLIC_SCHEMA_SYNC_WS_URL=
# Server-only (schema-sync process):
# SCHEMA_SYNC_DATABASE_URL=postgres://USER:PASSWORD@HOST:PORT/DB?sslmode=require
# SCHEMA_SYNC_LISTEN_ADDR=0.0.0.0:3031
# Match your control-plane JWT or use a shared API key for automation:
# SCHEMA_SYNC_API_KEY=
# SCHEMA_SYNC_JWT_HS256_SECRET=
# SCHEMA_SYNC_JWT_ISSUER=
# SCHEMA_SYNC_JWT_AUDIENCE=
# SCHEMA_SYNC_JWKS_URL=
# SCHEMA_SYNC_REQUIRE_AUTH=true
# Comma-separated origins for browser clients (e.g. http://localhost:3000)
# SCHEMA_SYNC_CORS_ORIGINS=

# Optional: Google Gemini for client-side AI (SQL review, chat, row fill, etc.).
# Create a key at https://aistudio.google.com/apikey
# This name is bundled into the client; treat it as sensitive and restrict the key in Google Cloud.
# You can instead leave this unset and paste a key in Settings → AI (stored in localStorage only).
NEXT_PUBLIC_GEMINI_API_KEY=
