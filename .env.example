# Copy to .env.local (never commit .env.local). See https://nextjs.org/docs/app/building-your-application/configuring/environment-variables

# Optional: Google Gemini for client-side AI (SQL review, chat, row fill, etc.).
# Create a key at https://aistudio.google.com/apikey
# This name is bundled into the client; treat it as sensitive and restrict the key in Google Cloud.
# You can instead leave this unset and paste a key in Settings → AI (stored in localStorage only).
NEXT_PUBLIC_GEMINI_API_KEY=
