# Sourced by `apple-scripts/tauri-ios-xcode.sh` (after ~/.cargo/env). Optional PATH tweaks for Xcode-only builds.
# Example:
# export PATH="/opt/homebrew/bin:$PATH"
#
# Physical iPad/iPhone: use Mac Wi‑Fi/LAN IP — NOT 192.0.0.2 (iPadOS routes that via lo0; dev server never reached).
# Run `pnpm ios:dev:open` from helixDB/ (uses scripts/ios-dev.sh + this folder’s .xcode.env.local).
# USB escape hatch: PGSTUDIO_IOS_ALLOW_USB_HOST=1  |  Simulator: PGSTUDIO_IOS_SIMULATOR=1 pnpm ios:dev:open
