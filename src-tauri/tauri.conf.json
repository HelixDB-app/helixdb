{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "pgStudio",
  "version": "1.4.5",
  "identifier": "com.pgstudio.helixdb",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "pgStudio",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": [
            "**/*"
          ]
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTools",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "entitlements": "./Entitlements.plist",
      "minimumSystemVersion": "12.0",
      "bundleVersion": "26",
      "files": {
        "embedded.provisionprofile": "../apple/pgstudio.provisionprofile"
      }
    },
    "iOS": {
      "developmentTeam": "GZM73634C6"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "pgstudio"
        ]
      }
    },
    "shell": {
      "open": true
    }
  }
}